package DoublyLinkedList;

public class DoublyLinkedList {
	
	public Node Head;
	public Node Tail;
	
	public void InsertSinglyNode(int NodeValue)
	{
		Node node=new Node();
		node.data=NodeValue;
		Head=node;
		Tail=node;
		return;
	}
		
	public int Size()
	{
		int index=1;
		Node TempNode=Head;
		while(TempNode.next!=null)
		{
			TempNode=TempNode.next;
			index++;
		}
		return index;
	}
	public void Traverse()
	{
		Node TempNode=Head;
		while(TempNode.next!=null)
		{
			System.out.print(TempNode.data+"->");
			TempNode=TempNode.next;
		}
		System.out.print(TempNode.data+"->");
	}
	public void InsertNode(int NodeValue,int Location)
	{
		Node node=new Node();
		node.data=NodeValue;
		if(Head==null)
		{
			InsertSinglyNode(NodeValue);
			return ;
		}
		else if(Location==0)
		{
			node.next=Head;
			Head.prev=node;
			Head=node;
			System.out.println("Node Inserted At Beginning");
			}
		else if(Location>Size())
		{
			Tail.next=node;
			node.prev=Tail;
			Tail=node;
			System.out.println("Node Inserted At End");
		}
		else {
			Node TempNode=Head;
			Node Previous=null;
			int index=0;
			(index<Location)
			{
				Previous=TempNode;
				TempNode=TempNode.next;
				index++;
			}
			Previous.next=node;
			node.next=TempNode.prev;
			
			System.out.println("Node Inserted At Location Given Location");
		}
	}
	

}

