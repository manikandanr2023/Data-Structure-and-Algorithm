package problem;
import java.util.*;
public class Main {
	public static void main(String args[])
	{
	int[][] obstacleGrid = {{0,0,0},{0,1,0},{0,0,0}};
	
	Solution sc=new Solution();
	System.out.println(sc.uniquePathsWithObstacles(obstacleGrid));
	}
}



class Solution {
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        int n = obstacleGrid.length;
        int m = obstacleGrid[0].length;
        int[][] dp = new int[n][m];
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
               
            	if((i==0||j==0)&&obstacleGrid[i][j]!=1)
            	{
            		dp[i][j]=1;
            	}
                if(obstacleGrid[i][j]==1)
                {
                	dp[i][j]=-1;
                }
            }
        }
        
        for(int i=1;i<n;i++)
        {
            for(int j=1;j<m;j++)
            {
            	if(dp[i][j]==-1)
            	{
            		continue;
            	}
            	else {
            		int a=0,b=0;
            		(dp[i-1][j]>0) ? a = dp[i-1][j]) : a = 0;
            		
            			
            		if(dp[i][j-1]==1) 
            		dp[i][j]=a+b;
            	}
            }
            }
        
        return dp[n-1][m-1];
    }
}
