class Solution {
    public int strStr(String haystack, String needle) {
        int j=0;
    int min=0;
    int count=0;
    boolean statement=false;
        for(int i=0;i<haystack.length();i++)
        {
            if(haystack.charAt(i)==needle.charAt(j))
            {
                j++;
            }
            else{
                j=0;
            }
            if(j==needle.length())
            {
            	count++;
            	if(count==1)
            	{
            		min=i-needle.length()+1;
            	}
            	
            	min=Math.min(min,i-needle.length()+1);
                j=0;
                statement=true;
            	}
            }
        
        if(statement==true)
        {
        	
        	return min;
        }
        return -1;
    }
}