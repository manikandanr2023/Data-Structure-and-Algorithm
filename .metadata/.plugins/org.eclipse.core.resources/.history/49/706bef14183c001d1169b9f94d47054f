
public class Create_admin_details {
	String admin_name,admin_age,admin_gender,admin_mail,admin_mobno,admin_branch;
	static int admin_id=0,admin_password=10;
public Create_admin_details(String admin_name,String admin_age,String admin_gender,String admin_mail,String admin_mobno,String admin_branch)
{
	this.admin_id=admin_id+1;
	this.admin_name=admin_name;
	this.admin_age=admin_age;
	this.admin_gender=admin_gender;
	this.admin_mail=admin_mail;
	this.admin_mobno=admin_mobno;
	this.admin_branch=admin_branch;
	this.admin_password=admin_password;
	
}


}
