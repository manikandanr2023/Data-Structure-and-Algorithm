import java.util.*;
public class manikandan {
	{
		public static void main(String[] args)
		{
			Scanner sc=new Scanner(System.in);
			int n=sc.nextInt();
			int[] arr1=new int[n];
			for(int i=0;i<arr1.length;i++)
			{
				for(int j=i+1;j<arr1.length;j++)
				{
					if(i!=j)
					{
						System.out.print(i);
					}
				}
			}
		}
	}
}
