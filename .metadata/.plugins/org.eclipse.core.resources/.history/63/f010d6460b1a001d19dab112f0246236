import java.util.*;
public class Main {
	public static void main(String args[])
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int[] arr=new int[n];
		int[] narr=new int[n];
		for(int i=0;i<n;i++)
		{
			arr[i]=sc.nextInt();
		}
		for(int i=0;i<n;i++)
		{
			narr[arr[i]]++;
		}
		for(int i=0;i<n;i++)
		{
			if(narr[i]==1)
			{
				System.out.println(i);
			}
		}
		
    }
}