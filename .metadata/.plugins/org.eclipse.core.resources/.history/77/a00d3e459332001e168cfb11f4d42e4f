class Solution {
    public String countAndSay(int n) {
       List<Integer> list=new ArrayList<>();
       list.add(1);
       int i=1;
       while(i<n)
       {
    	   int lastSize=list.get(list.size()-1);
    	   String numString=""+lastSize;
    	   System.out.println(numString);
    	   i++;
       }
       return "a";
    }
}
