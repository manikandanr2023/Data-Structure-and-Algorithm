import java.util.*;


public class Link {
	public static void main(String[] args)
	{String s="Hello World";
		Stack<String> stack=new Stack<>();
	     String t="";
	     
	        for(char a:s.toCharArray())
	        {
	        if(a==' ')
	        {
	          stack.push(t);
	          t="";
	        }
	        else{
	          t+=a;

	        }
	        }
	        System.out.println(stack);
	}
}