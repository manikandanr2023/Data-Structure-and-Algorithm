package mani;

public class Multi extends Thread{
	public void run() {
	for(int i=1;i<5;i++)
	{
		try {Thread.sleep(500000);}
		catch(InterruptedException e)
		{
			System.out.println(e);
		}
		System.out.println(i);
	}
	}
	public static void main(String argvs[])
	{
		
Multi m1=new Multi();
Multi m2=new Multi();
m1.start();
m2.start();
		
	}

}
