class Solution {
    public boolean isHappy(int n) {
        int rem = 0;
        int total=0;
        while(total!=1)
        {total=0;

       while(n!=0)
       {
           rem=n%10;
           total+=Math.pow(rem, 2);
           n/=10;

        }
       n=total;
       } 
        if(total==1)
        {
        return true;
    }
        return false;}
}