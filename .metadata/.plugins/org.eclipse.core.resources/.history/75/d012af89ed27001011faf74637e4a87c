package problem;
import java.util.*;
public class problem {

	public static void main(String[] args)
	{
		String s="ababbcaabbaaabbu";
		int k=2;
		ss sc=new ss();
		
		System.out.println(sc.longestSubstring(s,k));
	}
}
//TC -> O(N2)
//SC -> 26 *O(N)
class ss{
 public int longestSubstring(String s, int k) {
     int freq[] = new int[26];
     char[] str = s.toCharArray();
     for(char c: str){
         int index =c -'a';
         freq[index]++;
     }

     boolean valid = true;
     int start =0;
     int maxLen = 0;
     for(int end = 0;end<s.length();end++) {
         // TC -> O(N2)
         if(freq[str[end] - 'a'] >0 && freq[str[end] - 'a'] <k ){
             String subString = s.substring(start, end);
             maxLen  = Math.max(maxLen , longestSubstring(subString, k));
             start = end+1;
             valid = false;
         }
     }

     if(valid){
         return s.length();
     } else{
         return Math.max(maxLen, longestSubstring(s.substring(start), k));
     }
 }
}