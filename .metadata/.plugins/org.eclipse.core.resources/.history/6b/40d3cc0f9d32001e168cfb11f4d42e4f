class Solution {
    public String countAndSay(int n) {
    	String ans="";
       List<String> list=new ArrayList<>();
       list.add("1");
       int i=1;
    while(i<n)
    {String total = "";
    	String strSize=list.get(list.size()-1);
    	for(int j=0;j<strSize.length();j++)
    	{int count=1;
    	
    		if(strSize.length()-1!=j)
    		{
    		if(strSize.charAt(j)==strSize.charAt(j+1))
    		{
    			count+=1;
    			
    			j=+1;
    		}}
    		if(strSize.length()-1!=j)
    		{
    		if(strSize.charAt(j)!=strSize.charAt(j+1))
    		{
    			total+=""+count+strSize.charAt(j);
    		}}
    		if(strSize.length()-1==j)
    		{
    			total+=""+count+strSize.charAt(j);
    		}
    		
    	
    	}
    	list.add(total);
    }
    ans=list.get(list.size()-1);
    
       return ans;
    }
}
